# Kestrel Credit Appraisal Copilot - Environment Configuration (Backend only)

# Google Gemini API key (Read only on backend, never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM execution mode: 'simulated' (default) or 'live'
LLM_MODE=simulated

# Model configuration
PRIMARY_MODEL_ID=gemini-2.5-flash
FALLBACK_MODEL_ID=gemini-1.5-flash

# Auth and Security
JWT_SECRET=kestrel_dev_secret_jwt_key_at_least_32_chars_long_synthetic
PORT=3001
HOST=0.0.0.0

# Storage
DATA_DIR=./data
UPLOAD_DIR=./uploads
